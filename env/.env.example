# Per-device secrets. Copy to env/node_a/.env and env/node_b/.env and fill each in.
# Give every device its own DEVICE_HMAC_SECRET. uploadfs stores the file as /secrets.env.

WIFI_SSID="wifi-hotspot"
WIFI_PASS="wifi-password"
SERVER_BASE_URL="http://192.168.1.50:8000"
# This device's secret. The server stores it against this device's id.
# Node A also uses it for the BLE presence token. Node B only signs its photo uploads.
DEVICE_HMAC_SECRET="change-me-per-bus"
